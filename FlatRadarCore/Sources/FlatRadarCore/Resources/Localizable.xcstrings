    "None of the platforms you selected support this filter, so it currently has no effect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of the platforms you selected support this filter, so it currently has no effect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna de las plataformas que has seleccionado admite este filtro, así que ahora mismo no tiene efecto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen van de platforms die je hebt geselecteerd ondersteunt dit filter, dus het heeft nu geen effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选中的平台都不支持这个筛选条件，所以它当前不起作用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你選中的平台都不支援這個篩選條件，所以它目前不起作用。"
          }
        }
      }
    },
