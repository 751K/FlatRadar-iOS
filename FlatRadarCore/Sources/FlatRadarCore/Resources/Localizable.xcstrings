    "This listing could not be found; the link may have expired.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This listing could not be found; the link may have expired."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado este anuncio; puede que el enlace haya caducado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze advertentie is niet gevonden; de link is mogelijk verlopen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到这套房源，链接可能已失效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到這套房源，連結可能已失效。"
          }
        }
      }
    },
    "This listing is outside the current map view (past the freshness window or excluded by filters). Its location is marked below.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This listing is outside the current map view (past the freshness window or excluded by filters). Its location is marked below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este anuncio está fuera de la vista actual del mapa (fuera de la ventana de novedad o excluido por los filtros). Su ubicación se indica abajo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze advertentie valt buiten de huidige kaartweergave (buiten het versheidsvenster of uitgesloten door filters). De locatie is hieronder gemarkeerd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这套房源不在当前地图范围内（超出新鲜度窗口，或被筛选条件排除）。它的位置标在下面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這套房源不在目前地圖範圍內（超出新鮮度視窗，或被篩選條件排除）。它的位置標在下面。"
          }
        }
      }
    },
    "This listing's address has not been geocoded yet, so it has no position on the map.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This listing's address has not been geocoded yet, so it has no position on the map."
