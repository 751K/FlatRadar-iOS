# macOS
.DS_Store

# Xcode
build/
DerivedData/
**/xcuserdata/
**/.build/
*.xcuserstate
*.bak

# 签名材料，永远不进仓库
*.mobileprovision
*.cer
*.certSigningRequest
*.p12
*.p8

# App Store Connect API key（asc_api.py 从 ~/.config/asc/ 读，不从仓库读）
AuthKey_*.p8

# Python（scripts/ 与 tests/）
__pycache__/
*.pyc
.pytest_cache/

# 截图产物
/screenshots/
*.xcresult
*.xcresult.zip

# 图标：设计源 SVG 和生成脚本入库；生成物不入库
# （AppIcon.icon 本身是构建输入，在 FlatRadar/ 下，必须入库）
/output/icon/*.png
/output/icon/layers/
/output/icon/FlatRadar.icon/
