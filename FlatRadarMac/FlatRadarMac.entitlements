<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- App Sandbox 默认禁止出站连接。没有这一条登录请求直接失败。 -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- APNs。键名带 com.apple.developer. 前缀——iOS 那边是裸的 aps-environment，
	     照抄过来 macOS 不认，registerForRemoteNotifications 会直接失败。

	     写 development：Xcode 直接 Run 用开发描述文件签，拿到的是 sandbox token。
	     归档导出（TestFlight / App Store）时 Xcode 会把它改写成 production，
	     和 PushStore.currentEnv 的 #if DEBUG 两边对得上。本地用 Release 配置
	     直接 Run 是唯一对不上的组合（代码报 production、签名是 development）。 -->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>

	<!-- 设置 → Account → Export My Data 要把 JSON 存到用户选的位置。
	     沙盒默认连存盘面板都拿不到结果，只能写用户**亲手选的**那个路径，
	     所以是 user-selected，不是任意文件读写。 -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Keychain Sharing。
	     不是为了"共享"，是为了拿到 application-identifier：macOS 的
	     data protection 钥匙串（见 KeychainManager.dataProtection）要求签名带它，
	     否则每一次写入都是 -34018 errSecMissingEntitlement。只有声明了这个
	     entitlement，automatic signing 才会去签发带 application-identifier 的
	     描述文件——只勾 App Sandbox 是签不出来的。

	     连带要求：描述文件里内嵌允许运行的设备清单，所以这台 Mac 必须先在
	     开发者账号里注册（2026-09-09 已注册）。 -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.j.kong.FlatRadar</string>
	</array>
</dict>
</plist>
