<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- App Sandbox 默认禁止出站连接。没有这一条登录请求直接失败。 -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- APNs。键名带 com.apple.developer. 前缀——iOS 那边是裸的 aps-environment，
	     照抄过来 macOS 不认，registerForRemoteNotifications 会直接失败。

	     写 development：Xcode 直接 Run 用开发描述文件签，拿到的是 sandbox token。
	     归档导出（TestFlight / App Store）时 Xcode 会把它改写成 production，
	     和 PushStore.currentEnv 的 #if DEBUG 两边对得上。本地用 Release 配置
	     直接 Run 是唯一对不上的组合（代码报 production、签名是 development）。 -->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>

	<!-- 设置 → Account → Export My Data 要把 JSON 存到用户选的位置。
	     沙盒默认连存盘面板都拿不到结果，只能写用户**亲手选的**那个路径，
	     所以是 user-selected，不是任意文件读写。 -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- App Group。桌面小组件（FlatRadarMacWidget）和这个 app 之间唯一的通道：
	     app 把「匹配数 + 上次扫描时间」整份写进这个容器，小组件只读。
	     小组件因此不需要联网、不需要 token、也不需要知道服务器地址——
	     理由和那份数据的形状见 FlatRadarCore 的 `WidgetSnapshot` / `WidgetBridge`。

	     macOS 上组名**必须**带 team 前缀（`$(TeamIdentifierPrefix)` 展开成
	     `HGXZB3UC25.`）。写成 iOS 那样的裸 `group.` 时 `containerURL(...)` 返回
	     nil 而且不报错，症状只是小组件永远空着。 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.com.j.kong.FlatRadar</string>
	</array>

	<!-- Keychain Sharing。
	     不是为了"共享"，是为了拿到 application-identifier：macOS 的
	     data protection 钥匙串（见 KeychainManager.dataProtection）要求签名带它，
	     否则每一次写入都是 -34018 errSecMissingEntitlement。只有声明了这个
	     entitlement，automatic signing 才会去签发带 application-identifier 的
	     描述文件——只勾 App Sandbox 是签不出来的。

	     连带要求：描述文件里内嵌允许运行的设备清单，所以这台 Mac 必须先在
	     开发者账号里注册（2026-09-09 已注册）。 -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.j.kong.FlatRadar</string>
	</array>

	<!-- Universal Link。
	     ``https://flatradar.app/l/<id>`` 这类分享链接，装了 FlatRadar 的人点了
	     由系统直接交给 app，没装的人在浏览器里看公开落地页。两边都成立，是自定义
	     scheme（对没装的人是死链）和平台网址（对装了的人不唤起 app）都做不到的。

	     另一半在服务器上：``/.well-known/apple-app-site-association`` 必须
	     HTTPS、application/json、不重定向、不要鉴权（后端 app/routes/site_meta.py）。
	     **两边少一边就静默失效**——系统不报错，链接只是"在浏览器里打开了"。

	     只写 ``applinks:``，不写 ``webcredentials:``：后者是共享密码自动填充，
	     这个 app 用不到，多申请一项就多一项要向审核解释的权限。 -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:flatradar.app</string>
	</array>
</dict>
</plist>
