    "Tenant and occupancy are checked strictly: a listing that doesn't state them is filtered out.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquilino y ocupación se comprueban de forma estricta: un anuncio que no los indique queda excluido."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Huurder en bezetting worden strikt gecontroleerd: een woning die ze niet vermeldt valt af."
