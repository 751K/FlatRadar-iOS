    "This address has %lld listings. Their pins are spread apart so that each one can be tapped, so the positions shown are approximate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address has %lld listings. Their pins are spread apart so that each one can be tapped, so the positions shown are approximate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección tiene %lld anuncios. Sus marcadores se separan para poder tocarlos uno a uno, así que las posiciones mostradas son aproximadas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit adres heeft %lld advertenties. De pins zijn uit elkaar gezet zodat je ze allemaal kunt aantikken; de getoonde posities zijn dus bij benadering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个地址上有 %lld 套房源。为了每一套都能点到，图钉被散开了，所以显示的位置是近似的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個地址上有 %lld 套房源。為了每一套都能點到，圖釘被散開了，所以顯示的位置是近似的。"
          }
        }
      }
    },
