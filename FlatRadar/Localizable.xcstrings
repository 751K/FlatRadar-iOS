    "Narrow by city, platform, status, type, or energy label.\nUse search to find a specific address.\nActive filters appear as chips — tap to remove.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acota por ciudad, plataforma, estado, tipo o etiqueta energética.\nUsa la búsqueda para encontrar una dirección concreta.\nLos filtros activos aparecen como etiquetas: tócalas para quitarlas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter op stad, platform, status, type of energielabel.\nGebruik zoeken om een specifiek adres te vinden.\nActieve filters verschijnen als labels — tik erop om ze te verwijderen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按城市、平台、状态、房型或能耗等级收窄范围。\n用搜索查找具体地址。\n已生效的筛选会显示为标签，点一下即可移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按城市、平台、狀態、房型或能耗等級收窄範圍。\n用搜索查找具體地址。\n已生效的篩選會顯示為標籤，點一下即可移除。"
          }
        }
      }
    },
