          }
        }
      }
    },
    "You're still signed in on this device. We'll reconnect automatically when the connection is back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're still signed in on this device. We'll reconnect automatically when the connection is back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión sigue abierta en este dispositivo. Volveremos a conectar automáticamente cuando vuelva la conexión."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent op dit apparaat nog steeds ingelogd. We maken automatisch opnieuw verbinding zodra die er weer is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在这台设备上仍是登录状态。网络恢复后会自动重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在這台裝置上仍是登入狀態。網路恢復後會自動重新連線。"
          }
        }
      }
    },
    "You're welcome!": {
