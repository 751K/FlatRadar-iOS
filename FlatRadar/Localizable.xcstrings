    "A listing must match every condition below to notify you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anuncio debe cumplir todas las condiciones para avisarte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een woning moet aan alle onderstaande voorwaarden voldoen om je te melden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房源需同时满足以下全部条件才会通知你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "房源需同時滿足以下全部條件才會通知你。"
          }
        }
      }
    },
    "A one-time tip to support development.\nDoes not unlock any features.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A one-time tip to support development.\nDoes not unlock any features."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una contribución única para apoyar el desarrollo.\nNo desbloquea ninguna función."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een eenmalige donatie ter ondersteuning van de ontwikkeling.\nHiermee worden geen functies vrijgespeeld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性打赏以支持开发。\n不会解锁任何功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性打賞以支持開發。\n不會解鎖任何功能。"
          }
        }
      }
    },
    "A/A+/A++/A+++ above %@ also pass.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A/A+/A++/A+++ por encima de %@ también se aceptan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "A/A+/A++/A+++ boven %@ worden ook geaccepteerd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高于 %@ 的 A/A+/A++/A+++ 同样通过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高於 %@ 的 A/A+/A++/A+++ 同樣通過。"
          }
        }
      }
    },
