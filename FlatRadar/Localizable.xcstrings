    "All filters will be cleared. You'll start receiving notifications for every new listing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All filters will be cleared. You'll start receiving notifications for every new listing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán todos los filtros. Empezarás a recibir notificaciones cada vez que se publique un nuevo anuncio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle filters worden gewist. Je ontvangt voortaan meldingen voor elke nieuwe advertentie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有过滤条件将被清除。你将开始收到每条新房源的通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有過濾條件將被清除。你將開始收到每條新房源的通知。"
          }
        }
      }
    },
    "All types": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los tipos"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle soorten"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全类型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全類型"
          }
        }
      }
    },
    "Allow location access in Settings to center the map on your current position.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la ubicación en «Ajustes» para centrar el mapa en tu posición actual."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef in de instellingen toestemming voor locatietoegang om de kaart op je huidige locatie te centreren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中允许位置访问，以便将地图居中到你当前的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在“設置”中允許位置訪問，以便將地圖居中到你當前的位置。"
          }
        }
      }
    },
    "Always verify listing details on the official platform website before making decisions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba siempre los detalles del anuncio en la página web oficial de la plataforma antes de tomar una decisión."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer altijd de gegevens van de advertentie op de officiële website van het platform voordat u een beslissing neemt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做决定前，请在官方平台网站核实房源详情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做決定前，請在官方平台網站覈實房源詳情。"
          }
        }
      }
    },
    "An account keeps your notification filter and alert history, and lets FlatRadar push new listings to you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta conserva tu filtro de notificaciones y el historial de avisos, y permite que FlatRadar te envíe anuncios nuevos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een account blijven je meldingsfilter en meldingsgeschiedenis bewaard, en kan FlatRadar je nieuwe woningen sturen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户会保留你的通知筛选和提醒历史，并让 FlatRadar 把新房源推送给你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "賬戶會保留你的通知篩選和提醒歷史，並讓 FlatRadar 把新房源推送給你。"
          }
        }
      }
    },
