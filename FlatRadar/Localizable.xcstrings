          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "和"
          }
        }
      }
    },
    "or": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "o"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "of"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "或"
          }
        }
      }
    },
    "Shows the number of matching listings and the last scan time. FlatRadar keeps receiving live updates while it is on, even with every window closed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el número de anuncios coincidentes y la hora del último escaneo. FlatRadar sigue recibiendo actualizaciones en directo mientras está activo, incluso con todas las ventanas cerradas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont het aantal overeenkomende woningen en het tijdstip van de laatste scan. FlatRadar blijft live updates ontvangen zolang het actief is, zelfs als alle vensters gesloten zijn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示匹配房源数量和上次扫描时间。FlatRadar 运行时会持续接收实时更新，即使所有窗口都已关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示符合條件的房源數量和上次掃描時間。FlatRadar 執行時會持續接收即時更新，即使所有視窗都已關閉。"
          }
        }
      }
    },
    "The public stats endpoints didn’t answer. They don’t need a sign-in, so this is usually the server or the network.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las interfaces públicas de estadísticas no respondieron. No requieren iniciar sesión, así que normalmente se trata del servidor o de la red."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De openbare statistiek-endpoints reageerden niet. Inloggen is niet nodig, dus meestal ligt het aan de server of het netwerk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开统计接口没有响应。它们不需要登录，所以通常是服务器或网络问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公開統計端點沒有回應。它們不需要登入，所以通常是伺服器或網路問題。"
          }
        }
      }
    },
    "FlatRadar can't alert you about new listings or status changes. Turn on notifications for FlatRadar in System Settings → Notifications.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FlatRadar no puede avisarte de nuevos anuncios o cambios de estado. Activa las notificaciones de FlatRadar en Configuración del Sistema → Notificaciones."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "FlatRadar kan je niet waarschuwen voor nieuwe woningen of statuswijzigingen. Schakel meldingen voor FlatRadar in via Systeeminstellingen → Meldingen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FlatRadar 无法提醒你有新房源或状态变化。请在“系统设置”→“通知”中打开 FlatRadar 的通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "FlatRadar 無法提醒你有新房源或狀態變更。請在「系統設定」→「通知」中開啟 FlatRadar 的通知。"
          }
        }
      }
    },
    "Shows a reminder at launch if macOS isn't allowing FlatRadar to notify you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un recordatorio al iniciar si macOS no permite que FlatRadar te envíe notificaciones."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont bij het opstarten een herinnering als macOS FlatRadar niet toestaat je meldingen te sturen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 macOS 不允许 FlatRadar 发送通知，启动时显示提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 macOS 不允許 FlatRadar 傳送通知，啟動時顯示提醒。"
          }
        }
      }
    },
