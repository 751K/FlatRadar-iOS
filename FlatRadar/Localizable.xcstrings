    "You can enable it again next time you sign in with your password.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes volver a activarla la próxima vez que inicies sesión con tu contraseña."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt deze functie weer inschakelen wanneer je je de volgende keer met je wachtwoord aanmeldt."
          }
        },
        "zh-Hans": {
