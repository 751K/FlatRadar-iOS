          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel in Instellingen een meldingsfilter in om pushberichten te krijgen voor nieuwe woningen die aan je criteria voldoen.\nHet tabblad Meldingen toont live elke match."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置里配置通知筛选，符合条件的新房源会推送给你。\n「提醒」标签页实时列出每一条命中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
