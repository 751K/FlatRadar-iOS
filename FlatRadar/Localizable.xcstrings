          }
        }
      }
    },
    "List, Map, and Calendar show the same listings from different angles.\nSwitch between them with the picker at the top.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista, Mapa y Calendario muestran los mismos anuncios desde ángulos distintos.\nCambia entre ellos con el selector de arriba."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lijst, Kaart en Agenda tonen dezelfde woningen vanuit een andere hoek.\nWissel ertussen met de kiezer bovenaan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
