    "List, Map, and Calendar show the same listings from different angles.\nSwitch between them from the menu at the top left.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista, Mapa y Calendario muestran los mismos anuncios desde ángulos distintos.\nCambia entre ellos desde el menú de arriba a la izquierda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lijst, Kaart en Agenda tonen dezelfde woningen vanuit een andere hoek.\nWissel ertussen via het menu linksboven."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
