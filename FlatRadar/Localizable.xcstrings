    "This listing isn’t in the list — /map and /listings cover different sets, and your saved filter applies to the list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这套房源不在列表里——/map 和 /listings 覆盖的范围不同，而你保存的筛选条件只作用于列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這套房源不在列表裡——/map 和 /listings 涵蓋的範圍不同，而你儲存的篩選條件只作用於列表。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze advertentie staat niet in de lijst — /map en /listings bevatten verschillende sets, en je opgeslagen filter geldt voor de lijst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este anuncio no está en la lista: /map y /listings abarcan conjuntos distintos, y tu filtro guardado se aplica a la lista."
          }
        }
      }
    },
