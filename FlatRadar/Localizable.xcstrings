        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "租客与入住人数按严格口径核验：房源未标注该属性即被排除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "租客與入住人數按嚴格口徑核驗：房源未標註該屬性即被排除。"
