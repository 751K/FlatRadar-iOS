    "Your password is stored in the device Keychain, protected by %@. It never leaves this device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu contraseña se guarda en el Llavero del dispositivo, protegida por %@. Nunca sale de este dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
